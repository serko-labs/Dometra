{
  "expo": {
    "name": "Dometra",
    "slug": "dometra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "dometra",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.dometra"
    },
    "android": {
      "package": "com.example.dometra",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Dometra to photograph utility meters."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dometra to select utility meter photos from your photo library."
        }
      ],
      "expo-localization",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0c857bf-adc5-425c-8bb9-5d657b6ca1d2"
      }
    }
  }
}
