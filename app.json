{
  "expo": {
    "name": "Dometra",
    "slug": "dometra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dometra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.serkolabs.dometra"
    },
    "android": {
      "package": "com.example.dometra",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#325BE6"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Dometra to photograph utility meters."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dometra to select utility meter photos from your photo library."
        }
      ],
      "expo-localization",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}